# ${SERVER_NAME} and ${DJANGO_ADMIN_PATH} are filled in from the environment
# when the container starts.

# Like the standard log, but the path without the query string: the live
# socket signs in with ?token=..., which must never reach a log file.
log_format wasel_no_query '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                          '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

upstream django {
    server web:8000;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# HTTP: answer Let's Encrypt, send everyone else to HTTPS.
server {
    listen 80;
    server_name ${SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    server_tokens off;
    client_max_body_size 5m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Django static files (admin, login and tracking pages).
    location /static/ {
        alias /var/www/static/;
        expires 30d;
        access_log off;
    }

    # The Django admin: an emergency tool for superusers, at a path only the team knows.
    location ^~ /${DJANGO_ADMIN_PATH}/ {
        add_header X-Robots-Tag "noindex, nofollow" always;
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Platform admin for the Wasel team (single-page app built with base /admin/).
    location = /admin {
        absolute_redirect off;
        return 301 /admin/;
    }

    location ^~ /admin/assets/ {
        root /usr/share/nginx;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff;
        try_files $uri =404;
    }

    # Signed in with a session cookie: only its own scripts, only this server,
    # never framed, never indexed.
    location ^~ /admin/ {
        root /usr/share/nginx;
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
        add_header X-Frame-Options DENY always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files $uri /admin/index.html;
    }

    # Django: API, the staff operations page and its own web pages.
    location ~ ^/(api|api-auth|ops|login|track|healthz)(/|$) {
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }

    # Live order socket: keep connections open for an hour between pings.
    location /ws/ {
        access_log /var/log/nginx/access.log wasel_no_query;
        proxy_pass http://django;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Store portal (single-page app). Built assets have hashed names.
    root /usr/share/nginx/portal;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff;
        try_files $uri =404;
    }

    # The portal keeps its sign-in token in the browser, so it only runs its
    # own scripts, talks only to this server, and can't be framed by others.
    location / {
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss://$host; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
        add_header X-Frame-Options DENY always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        try_files $uri /index.html;
    }
}
