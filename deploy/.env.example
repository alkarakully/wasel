# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Public domain (DNS must point at this server for Let's Encrypt).
SERVER_NAME=wasel.example.com

# Django
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=wasel.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://wasel.example.com
DJANGO_DEBUG=0
DJANGO_LOG_LEVEL=WARNING
# Where the Django admin (superusers only, for emergencies) lives. The platform
# admin is at /admin/. Pick something long and random, without slashes.
DJANGO_ADMIN_PATH=generate-a-random-path

# Database (used by Postgres and to build Django's DATABASE_URL)
POSTGRES_DB=wasel
POSTGRES_USER=wasel
POSTGRES_PASSWORD=generate-a-strong-password

# WhatsApp login codes (Meta Cloud API). Leave empty to disable.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=wasel_login_code
WHATSAPP_TEMPLATE_LANGUAGE=ar

# Email login codes through any SMTP provider (Gmail/Workspace, Zoho, Mailgun, Brevo, SES SMTP...).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=Wasel <no-reply@example.com>

# Map styles for the web tracking page (optional; default OpenFreeMap).
MAP_STYLE_LIGHT=
MAP_STYLE_DARK=

# Ports nginx listens on (change only when testing locally).
HTTP_PORT=80
HTTPS_PORT=443
