# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Docker Hub account the images were pushed to, and which version to run.
DOCKERHUB_USER=your-dockerhub-username
NAWSIL_TAG=latest

# Public domain (DNS must point at this server for Let's Encrypt).
SERVER_NAME=nawsil.example.com

# Django
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=nawsil.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://nawsil.example.com
DJANGO_DEBUG=0
DJANGO_LOG_LEVEL=WARNING
# Where the Django admin (superusers only, for emergencies) lives. The platform
# admin is at /admin/. Long and random, without slashes.
DJANGO_ADMIN_PATH=generate-a-random-path

# Database (used by Postgres and to build Django's DATABASE_URL)
POSTGRES_DB=nawsil
POSTGRES_USER=nawsil
POSTGRES_PASSWORD=generate-a-strong-password

# Server size. Defaults suit 4 CPUs / 16 GB. For 8 GB use 2GB / 5GB / 8MB / 256MB;
# for 4 GB use 1GB / 2GB / 4MB / 128MB, and set WEB_CONCURRENCY to 2 per CPU.
WEB_CONCURRENCY=8
PG_SHARED_BUFFERS=4GB
PG_EFFECTIVE_CACHE_SIZE=10GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=512MB

# WhatsApp login codes (Meta Cloud API). Required for sign-up: without them no
# sign-in code can be sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=nawsil_login_code
WHATSAPP_TEMPLATE_LANGUAGE=ar

# How customers pay: cash on delivery only for now.
PAYMENT_METHODS=cod

# Email login codes through any SMTP provider (optional).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=Nawsil <no-reply@example.com>

# Map styles for the web tracking page (optional; default OpenFreeMap).
MAP_STYLE_LIGHT=
MAP_STYLE_DARK=

# Ports nginx listens on.
HTTP_PORT=80
HTTPS_PORT=443
